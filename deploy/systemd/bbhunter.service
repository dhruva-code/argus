[Unit]
Description=Argus gateway (API + in-process scheduler)
Documentation=https://github.com/argus-platform/argus
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
# Not a hard dependency: postgres/redis may run elsewhere (Docker Compose,
# a managed service) — the gateway's own readiness check handles the case
# where they're not up yet at process start (retries on connect).

[Service]
Type=simple
User=argus
Group=argus
WorkingDirectory=/opt/argus/apis/gateway
EnvironmentFile=/opt/argus/.env
ExecStart=/opt/argus/apis/gateway/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillSignal=SIGTERM

# Resource limits — tune for your host; these are conservative defaults.
MemoryMax=2G
CPUQuota=200%
TasksMax=512

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/argus/logs /opt/argus/runtime /opt/argus/backups
ProtectHome=true

# Structured logs to the journal (same format run.sh's logs/*.log capture).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=argus-gateway

[Install]
WantedBy=multi-user.target
