# ─── Argus configuration ─────────────────────────────────────────────────────
# Copy to .env and replace every CHANGE_ME. Never commit .env.
# Generate a strong value with:  openssl rand -hex 32

# ── Core ────────────────────────────────────────────────────────────────────
ARGUS_ENV=development                 # development | production
ARGUS_LOG_LEVEL=info                  # debug | info | warning | error

# ── Database ────────────────────────────────────────────────────────────────
# Predictable default (argus/argus) — this is a self-hosted, single-operator
# tool; ./install.sh writes this same default into a fresh .env. Change it
# (and re-run ./repair.sh --reset-database) for any shared/production/
# internet-facing deployment.
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
POSTGRES_DB=argus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL used by the gateway (async) and alembic (sync). Compose fills host.
DATABASE_URL=postgresql+asyncpg://argus:argus@postgres:5432/argus

# ── Redis (job queue + event bus) ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage (S3-compatible; MinIO in Compose) ────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=argus
S3_SECRET_KEY=CHANGE_ME_minio_secret
S3_BUCKET=argus-artifacts
S3_FORCE_PATH_STYLE=true

# ── Authentication ──────────────────────────────────────────────────────────
# Signs JWTs. Rotating it invalidates all existing sessions.
JWT_SECRET=CHANGE_ME_jwt_secret_hex32
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
# Fernet key encrypting stored tool API keys at rest. Back this up with the DB.
# Generate:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=CHANGE_ME_fernet_key
# Default web-login password for the bootstrap admin account
# (ashborn-admin@ashborn.local), created automatically by ./install.sh via
# `python -m app.bootstrap_admin`. Predictable on purpose, matching
# POSTGRES_PASSWORD above — change it (Settings -> Security) after first
# login, especially for any shared/production deployment.
ARGUS_DEFAULT_ADMIN_PASSWORD=argus

# ── Gateway API ─────────────────────────────────────────────────────────────
ARGUS_API_HOST=0.0.0.0
ARGUS_API_PORT=8000
# Comma-separated origins allowed to call the API from a browser.
ARGUS_CORS_ORIGINS=http://localhost:3000
# One-time first-run setup wizard is only reachable while this is true AND no
# users exist. It is ignored once the first admin is created.
ARGUS_ALLOW_SETUP=true
# Guards the demo seed command. Keep false in production.
ARGUS_ALLOW_SEED=false

# ── Orchestrator (Go) ───────────────────────────────────────────────────────
ORCH_WORKER_CONCURRENCY=4
ORCH_HEARTBEAT_SECONDS=10
ORCH_GATEWAY_URL=http://gateway:8000
# Shared secret the orchestrator uses to authenticate to the gateway's
# internal endpoints (job status callbacks, scope-policy fetch).
ORCH_INTERNAL_TOKEN=CHANGE_ME_internal_token

# ── SSRF policy (applies to every outbound request the platform makes) ──────
# Blocked by default: loopback, RFC1918, link-local, CGNAT, cloud metadata.
# Comma-separated CIDRs an operator explicitly re-allows (rare).
SSRF_ALLOW_CIDRS=
SSRF_BLOCK_METADATA=true

# ── Tools ───────────────────────────────────────────────────────────────────
# Directory the orchestrator (and install.sh's tool installer) looks in first
# for tool binaries, before $PATH. install.sh defaults this to ~/.local/bin
# for native installs — /usr/local/bin here matches the Docker image, which
# runs as root and installs tools there.
ARGUS_TOOLS_BIN_DIR=/usr/local/bin
# Wordlist directory for ffuf directory discovery, and the specific wordlist
# file (basename inside that directory) to use.
ARGUS_WORDLISTS_DIR=
ARGUS_FFUF_WORDLIST=common.txt
# Root of a local nuclei-templates checkout (empty = nuclei's own default).
ARGUS_NUCLEI_TEMPLATES_DIR=
# "" | "top-100" | "top-1000" | explicit list — naabu port spec default.
ARGUS_NAABU_PORTS=top-1000
# Injection Testing Engine (§1-13 of the platform enhancement spec).
ARGUS_MAX_INJECTION_PARAMS=60
# Public base URL the TARGET can reach for SSRF/RFI out-of-band callbacks —
# "" disables those two classes entirely rather than faking verification.
ARGUS_OAST_COLLECTOR_URL=
ARGUS_XSS_BROWSER_VERIFY=true
# Set to "off" to disable the in-process continuous-monitoring scheduler.
ARGUS_SCHEDULER=on

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Optional external intelligence APIs (all optional; platform works without) ─
SECURITYTRAILS_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
URLSCAN_API_KEY=
CHAOS_API_KEY=
GITHUB_TOKEN=
# AI-assisted analysis (optional — a heuristic fallback is used when this is
# unset, so the platform is fully functional without it). Prefer configuring
# this per-org instead, under Settings -> AI & Analysis in the UI (stored
# encrypted at rest, masked in the UI) — these env vars are a fallback used
# only when no org has AI enabled via that UI. See docs/AI_ANALYSIS.md.
ARGUS_AI_API_KEY=
ARGUS_AI_MODEL=claude-sonnet-5

# ── Notifications (optional) ────────────────────────────────────────────────
# Per-project Slack/webhook (app/services/notify.py, set on the project's
# notification_policy) — these two are still config-time defaults some
# deployments wire in, not required.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Per-user email notifications + registration/verification/password-reset
# mail (app/core/email.py). EMAIL_PROVIDER selects the backend; only "smtp"
# is actually implemented — see docs/AUTHENTICATION.md. Leaving SMTP_HOST
# unset disables outbound mail entirely (registration/login still work;
# verification emails just won't arrive, which every affected endpoint
# reports rather than silently pretending to send).
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=argus@localhost

# Telegram notifications (app/core/telegram.py, Bot API only — see
# docs/AUTHENTICATION.md). Create a bot via @BotFather to get a token; the
# bot's own @username (no leading @) is used to build the Settings →
# Notifications → Telegram pairing deep link. Leaving TELEGRAM_BOT_TOKEN
# unset disables Telegram pairing/sending (the pairing poller simply never
# starts — see app/services/notifications.py).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── HashiCorp Vault Transit secret backend (optional; local Fernet is the
#    default when these are unset) ───────────────────────────────────────────
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY=
VAULT_TRANSIT_MOUNT=transit

# ── Observability (optional) ────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
